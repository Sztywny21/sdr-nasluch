# Skopiuj ten plik na .env i wpisz klucze. Git tego pliku .env nie zapisuje.
GROQ_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Głos na gnieździe. Nazwy weź z: pactl list short sinks
AUDIO_SINK=alsa_output.pci-0000_00_1f.3.analog-stereo
AUDIO_HDMI=alsa_output.pci-0000_00_1f.3.hdmi-stereo
AUDIO_CARD=alsa_card.pci-0000_00_1f.3
XDG_RUNTIME_DIR=/run/user/1000
